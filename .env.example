# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Advanced Inventory POS & Accounting System
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask Core ────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — uses pos.db file)
# DATABASE_URL=sqlite:///pos.db

# MySQL (recommended for production)
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3307/pos_accounting

# PostgreSQL (alternative)
# DATABASE_URL=postgresql://user:password@localhost:5432/pos_accounting

# ── Email (Flask-Mail) ────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216

# ── App Settings ──────────────────────────────────────────────────────────────
ITEMS_PER_PAGE=20
LOW_STOCK_THRESHOLD=5

# ── Docker / Production Only ──────────────────────────────────────────────────
# GUNICORN_WORKERS=4
# GUNICORN_BIND=0.0.0.0:5000
